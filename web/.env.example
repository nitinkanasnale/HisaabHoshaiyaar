# Copy to .env in the project root. Never put secrets in client/VITE variables.
PORT=5000
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/hisaab_hoshiyaar?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
